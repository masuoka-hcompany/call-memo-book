{
  "permissions": {
    "deny": [
      "Bash(*npm run deploy*)",
      "Bash(*npm run setup*)",
      "Bash(*npm run destroy*)",
      "Bash(*scripts/deploy.ts*)",
      "Bash(*scripts/setup.ts*)",
      "Bash(*scripts/destroy.ts*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler secret*)",
      "Bash(*wrangler* --remote*)",
      "Read(./.env)",
      "Read(./.dev.vars)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/biome\" ]; then node \"$CLAUDE_PROJECT_DIR/scripts/format-edited.ts\"; fi"
          }
        ]
      }
    ]
  }
}
