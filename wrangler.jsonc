// Wrangler 設定ファイル
// https://developers.cloudflare.com/workers/wrangler/configuration/
//
// - account_id はここに書かず、環境変数 CLOUDFLARE_ACCOUNT_ID で指定する。
// - name / d1_databases の database_name・database_id は `npm run setup` が書き込む。
//   （yourname-appname / 0000... はプレースホルダ。ローカル開発はこのままでも動く）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yourname-appname",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],

  // 勉強会中は workers.dev で公開する（管理者が Access で保護済み）
  "workers_dev": true,
  "preview_urls": true,

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yourname-appname-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // デプロイ先の環境依存値。ローカルでは .dev.vars の値で上書きされる。
  // ACCESS_TEAM_DOMAIN / ACCESS_AUD が空のままだと、すべてのリクエストを拒否する（フェイルクローズ）。
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
