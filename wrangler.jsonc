// Wrangler 設定ファイル
// https://developers.cloudflare.com/workers/wrangler/configuration/
//
// - account_id はここに書かず、環境変数 CLOUDFLARE_ACCOUNT_ID で指定する。
// - name / d1_databases の database_name・database_id は `npm run setup` が書き込む。
//   （your-worker-name / 0000... はプレースホルダ。ローカル開発はこのままでも動く）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "call-memo-book",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],

  // 勉強会中は workers.dev で公開し、Access アプリケーションで保護する（docs/cloudflare-setup.md）
  "workers_dev": true,
  // プレビュー URL は Access アプリケーションの対象外になるため無効にする
  "preview_urls": false,

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "call-memo-book-db",
      "database_id": "9c15448c-a7dc-47bf-ae91-c90dcf79cfa2",
      "migrations_dir": "migrations"
    }
  ],

  // 必須の secret はない。この指定があると、wrangler は .dev.vars のキーを型（wrangler types）に足さず、
  // ローカルでも vars に宣言したキーだけを .dev.vars から読む。
  // 手元の .dev.vars の中身で worker-configuration.d.ts が変わらないようにするための指定。
  "secrets": { "required": [] },

  // デプロイ先の環境依存値。ローカルでは .dev.vars の値で上書きされる。
  // ACCESS_TEAM_DOMAIN / ACCESS_AUD が空のままだと、すべてのリクエストを拒否する（フェイルクローズ）。
  // DEV_USER_EMAIL はローカル専用（ENVIRONMENT=local のときだけ使う）。.dev.vars で上書きできるように、空で宣言しておく。
  "vars": {
    "ENVIRONMENT": "production",
    "DEV_USER_EMAIL": "",
    "ACCESS_TEAM_DOMAIN": "summer-block-0388.cloudflareaccess.com",
    "ACCESS_AUD": "467945e639d352f95a060052fc464d00b01c0c76586aab58cbd5e1d69ca2fd7e"
  }
}
